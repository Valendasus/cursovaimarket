// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  FREELANCER
  ADMIN
}

enum ServiceCategory {
  MATHEMATICS
  ECONOMICS
  INFORMATICS
  LAW
  HISTORY
  PSYCHOLOGY
  PHYSICS
  CHEMISTRY
  BIOLOGY
  ENGINEERING
  MANAGEMENT
  OTHER
}

enum ServiceLevel {
  BACHELOR
  SPECIALIST
  MASTER
}

enum OrderStatus {
  PENDING // создан, ждёт подтверждения исполнителя
  AWAITING_PAYMENT // исполнитель подтвердил, ждём оплаты заказчиком
  ACCEPTED // @deprecated: старый статус «подтверждён+оплачен»; новый флоу его не создаёт
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

// Состояние денег живёт отдельно от OrderStatus: статус заказа — про работу,
// статусы ниже — про деньги. Иначе OrderStatus распухает и становится нечитаемым.

enum PaymentStatus {
  PENDING // списание инициировано, ждём ответ провайдера
  SUCCEEDED // деньги списаны с заказчика
  FAILED // провайдер отказал (нет средств, отклонена карта)
  REFUNDED // возврат заказчику
}

enum PayoutStatus {
  PENDING // выплата поставлена в очередь
  SENT // деньги ушли исполнителю
  FAILED // провайдер отказал в выплате
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String    @unique
  avatar          String?
  role            UserRole  @default(STUDENT)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Freelancer profile (only if role = FREELANCER)
  profile FreelancerProfile?

  // Relations
  services           Service[]                @relation("FreelancerServices")
  buyerOrders        Order[]                  @relation("BuyerOrders")
  freelancerOrders   Order[]                  @relation("FreelancerOrders")
  reviews            Review[]                 @relation("AuthorReviews")
  chatMessages       ChatMessage[]
  conversationsAsA   Conversation[]           @relation("ConversationA")
  conversationsAsB   Conversation[]           @relation("ConversationB")
  directMessages     DirectMessage[]
  refreshSessions    RefreshSession[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

// ─── Email verification tokens ───────────────────────────────────────────────

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique // random opaque token sent in the verification link
  userId    String
  expiresAt DateTime
  usedAt    DateTime? // set once the token is consumed (single-use)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── Refresh sessions (revocable refresh tokens) ─────────────────────────────

model RefreshSession {
  id        String    @id @default(cuid())
  jti       String    @unique // matches the `jti` claim of the refresh JWT
  userId    String
  expiresAt DateTime
  revokedAt DateTime? // set on rotation / logout; reuse of a revoked token = theft
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model FreelancerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String   @default("")
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  completedOrders Int      @default(0)
  specializations String[]
  isVerified      Boolean  @default(false)
  telegram        String?
  responseTime    String   @default("~24 часа")
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("freelancer_profiles")
}

model Service {
  id           String          @id @default(cuid())
  freelancerId String
  title        String
  description  String
  category     ServiceCategory
  level        ServiceLevel
  tags         String[]
  thumbnail    String?
  images       String[]
  rating       Float           @default(0)
  reviewsCount Int             @default(0)
  ordersCount  Int             @default(0)
  isFeatured   Boolean         @default(false)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  freelancer User             @relation("FreelancerServices", fields: [freelancerId], references: [id])
  packages   ServicePackage[]
  orders     Order[]
  reviews    Review[]

  @@map("services")
}

model ServicePackage {
  id           String   @id @default(cuid())
  serviceId    String
  name         String // Базовый / Стандарт / Премиум
  description  String?
  price        Int // in kopecks (RUB * 100)
  deliveryDays Int
  revisions    Int      @default(1)
  features     String[]

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("service_packages")
}

model Order {
  id           String      @id @default(cuid())
  serviceId    String
  packageId    String
  studentId    String
  freelancerId String
  status       OrderStatus @default(PENDING)
  requirements String?
  totalPrice   Int // in kopecks
  deadline     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Подтверждение исполнителем: он должен успеть до confirmDeadline,
  // иначе заказ отменяется. Деньги на этом этапе ещё не списаны.
  confirmDeadline DateTime?
  confirmedAt     DateTime?

  service    Service        @relation(fields: [serviceId], references: [id])
  package    ServicePackage @relation(fields: [packageId], references: [id])
  student    User           @relation("BuyerOrders", fields: [studentId], references: [id])
  freelancer User           @relation("FreelancerOrders", fields: [freelancerId], references: [id])
  review     Review?
  messages   ChatMessage[]
  payment    Payment?
  payout     Payout?

  @@map("orders")
}

// ─── Деньги ──────────────────────────────────────────────────────────────────

/// Списание с заказчика. Создаётся в момент подтверждения заказа исполнителем.
model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique // один заказ — одно списание
  amount        Int // сколько списано с заказчика, в копейках
  fee           Int           @default(0) // комиссия платформы, в копейках
  status        PaymentStatus @default(PENDING)
  /// Идентификатор платежа на стороне провайдера — по нему сверяемся в вебхуке
  providerRef   String?
  failureReason String?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

/// Выплата исполнителю. Уходит сразу после успешного списания —
/// сумма заказа минус комиссия платформы.
model Payout {
  id            String       @id @default(cuid())
  orderId       String       @unique
  amount        Int // сколько ушло исполнителю (amount платежа минус fee)
  status        PayoutStatus @default(PENDING)
  providerRef   String?
  failureReason String?
  createdAt     DateTime     @default(now())
  sentAt        DateTime?
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payouts")
}

model Review {
  id        String   @id @default(cuid())
  serviceId String
  orderId   String   @unique
  authorId  String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  author  User    @relation("AuthorReviews", fields: [authorId], references: [id])

  @@map("reviews")
}

model ChatMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("chat_messages")
}

// ─── Direct messaging (user-to-user, no order required) ──────────────────────

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA    User            @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User            @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}
