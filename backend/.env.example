# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cursovai?schema=public"

# JWT
JWT_SECRET=change-me-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email verification
# Base URL of the frontend (verification links point here). Falls back to CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173
# How long a verification link stays valid
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Uploads
UPLOADS_DIR=uploads
AVATAR_SUBDIR=avatars
MESSAGE_SUBDIR=messages
PUBLIC_URL=http://localhost:3000
DEFAULT_AVATARS=https://api.dicebear.com/7.x/avataaars/svg?seed=ivan,https://api.dicebear.com/7.x/avataaars/svg?seed=maria,https://api.dicebear.com/7.x/avataaars/svg?seed=alex,https://api.dicebear.com/7.x/avataaars/svg?seed=elena,https://api.dicebear.com/7.x/avataaars/svg?seed=olga,https://api.dicebear.com/7.x/avataaars/svg?seed=sergey

# S3 (Selectel)
S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=avatars66232
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_SIGNED_URL_EXPIRES=3600

# Платежи
# Комиссия платформы в процентах: заказчик платит полную сумму,
# исполнитель получает её за вычетом этого процента.
PLATFORM_FEE_PERCENT=10
