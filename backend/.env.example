# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cursovai?schema=public"

# JWT
JWT_SECRET=change-me-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Socket.IO protection (chat namespace)
# Concurrent authenticated sockets and sockets behind one IP
SOCKET_MAX_CONNECTIONS_PER_USER=5
SOCKET_MAX_CONNECTIONS_PER_IP=30
# Enable only when direct backend access is closed and a trusted proxy sets X-Forwarded-For
SOCKET_TRUST_PROXY=false
# All incoming events per user within the window
SOCKET_MESSAGE_LIMIT=120
SOCKET_MESSAGE_WINDOW_MS=10000
# Maximum encoded Socket.IO event size (32 KiB) and joined application rooms
SOCKET_MAX_EVENT_BYTES=32768
SOCKET_MAX_ROOMS=2
# Connection attempts from one IP within the window
SOCKET_RECONNECT_LIMIT=20
SOCKET_RECONNECT_WINDOW_MS=60000
# Native Socket.IO heartbeat
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
# Repeated limit violations trigger a temporary user/IP block
SOCKET_ABUSE_THRESHOLD=5
SOCKET_ABUSE_WINDOW_MS=60000
SOCKET_BLOCK_DURATION_MS=900000
# Chat-specific sends per conversation (in addition to the global event limit)
CHAT_SEND_LIMIT=20
CHAT_SEND_WINDOW_MS=10000

# Email verification
# Base URL of the frontend (verification links point here). Falls back to CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173
# OAuth: create web applications with Google and Yandex (see README.md, section OAuth).
# Keep secrets ONLY on the backend. Empty values disable the respective button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/yandex/callback
# How long a verification link stays valid
EMAIL_VERIFICATION_EXPIRES_IN=24h
# How long a password-change link stays valid
PASSWORD_RESET_EXPIRES_IN=1h

# Uploads
UPLOADS_DIR=uploads
AVATAR_SUBDIR=avatars
MESSAGE_SUBDIR=messages
PUBLIC_URL=http://localhost:3000
DEFAULT_AVATARS=https://api.dicebear.com/7.x/avataaars/svg?seed=ivan,https://api.dicebear.com/7.x/avataaars/svg?seed=maria,https://api.dicebear.com/7.x/avataaars/svg?seed=alex,https://api.dicebear.com/7.x/avataaars/svg?seed=elena,https://api.dicebear.com/7.x/avataaars/svg?seed=olga,https://api.dicebear.com/7.x/avataaars/svg?seed=sergey

# S3 (Selectel)
S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=avatars66232
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_SIGNED_URL_EXPIRES=3600

# Платежи
# Комиссия платформы в процентах: заказчик платит полную сумму,
# исполнитель получает её за вычетом этого процента.
PLATFORM_FEE_PERCENT=13

# ─── Почта (транзакционные письма) ───────────────────────────────────────────
# Отправитель (общий для всех транспортов)
MAIL_FROM_EMAIL=noreply@yourdomain.ru
MAIL_FROM_NAME=КурсовойМаркет

# Основной транспорт — Unisender Go (HTTP API). Без ключа не используется.
# HOST: go1.unisender.ru или go2.unisender.ru (зависит от ДЦ вашего аккаунта)
UNISENDER_GO_API_KEY=
UNISENDER_GO_HOST=go1.unisender.ru

# Запасной транспорт — SMTP (nodemailer). Включается, если Unisender не задан
# или вернул ошибку. Без host/user/pass не используется.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
